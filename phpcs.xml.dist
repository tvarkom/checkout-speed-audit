<?xml version="1.0"?>
<ruleset name="Tvarkom Checkout Speed Audit">
	<description>WordPress Coding Standards and PHP 7.4 compatibility for the plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Requires PHP: 7.4 and Requires at least: 6.5 in the plugin header. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tvarkom-checkout-speed-audit-for-woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="tvarkom_csa"/>
				<element value="TVARKOM_CSA"/>
				<element value="Tvarkom_CSA"/>
			</property>
		</properties>
	</rule>
	<!-- manage_woocommerce is registered by WooCommerce. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
	<!-- The PHPUnit tests (tests/) aren't shipped. PHPUnit finds them as test-*.php (phpunit.xml.dist),
	     test method names say what they check, the lock tests read the option row directly on purpose,
	     and the WordPress test suite sets its own constants, globals and request variables. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/test-*\.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
